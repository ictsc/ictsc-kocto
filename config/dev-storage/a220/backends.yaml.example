# 未検証。プレースホルダーを実機の値で置換してから、Tridentのnamespaceへ適用する。
# iSCSIのdataLIFは指定しない。TridentがSVMのiSCSI LIFとLUNの経路を検出する。
apiVersion: trident.netapp.io/v1
kind: TridentBackendConfig
metadata:
  name: a220-san
  namespace: trident
spec:
  version: 1
  backendName: a220-san
  storageDriverName: ontap-san
  sanType: iscsi
  managementLIF: REPLACE_SVM_MANAGEMENT_LIF
  svm: REPLACE_SVM_NAME
  credentials:
    name: a220-ontap-credentials
  defaults:
    spaceReserve: none
    snapshotPolicy: none
    splitOnClone: "false"
---
apiVersion: trident.netapp.io/v1
kind: TridentBackendConfig
metadata:
  name: a220-nas
  namespace: trident
spec:
  version: 1
  backendName: a220-nas
  storageDriverName: ontap-nas
  nasType: nfs
  managementLIF: REPLACE_SVM_MANAGEMENT_LIF
  dataLIF: REPLACE_NFS_DATA_LIF
  svm: REPLACE_SVM_NAME
  credentials:
    name: a220-ontap-credentials
  defaults:
    exportPolicy: REPLACE_EXPORT_POLICY
    spaceReserve: none
    snapshotPolicy: none
    splitOnClone: "false"
