# 未検証。Talos v1.14用の追加設定例。現在のCeph検証ノードへは適用しない。
apiVersion: v1alpha1
kind: KernelModuleConfig
name: scsi_transport_iscsi
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: libiscsi_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: iscsi_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_multipath
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: dm_round_robin
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: multipath.conf
mode: 0o644
contents: |
  defaults {
      user_friendly_names no
      find_multipaths no
      path_selector "round-robin 0"
  }
  # CephやOSのディスクをmultipathの対象にしない。
  blacklist {
      devnode "^(rbd|vd|loop|sr)"
      device {
          vendor ".*"
          product ".*"
      }
  }
  blacklist_exceptions {
      device {
          vendor "NETAPP"
          product "LUN.*"
      }
  }
